# Optional .env loaded at startup before config resolution.
# Every entry is injected into the process environment (overwriting
# pre-existing vars), so callers don't need to export them manually.
# Copy to .env and adjust as needed. .env is gitignored.

# Where the YAML config lives:
TIMELOG_CONFIG_PATH=config.yml

# Postgres DSN used by `make migrate`
# MIGRATE_DSN=postgres://timelog:timelog@localhost:5432/timelog?sslmode=disable

# MCP settings (the only struct fields with env tags):
# MCP_ENABLED=false
# MCP_LEVEL=debug
# MCP_PATH=logs/mcp.log
# MCP_TRANSPORT=stdio
# MCP_LISTEN_ADDR=:8080
# MCP_TOKEN=

# Optional: disable MCP debug logging entirely (checked directly by mcp/logger.go).
# MCP_DEBUG=false
